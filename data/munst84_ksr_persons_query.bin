function PriznInfoItem( P, PN, No ){
this.PriznName=PN;
this.Prizn=P;
this.No=No;
this.TPart="";
}
function CreatePriznInfo(){
PriznInfo=new Array();
PriznInfo[0]=new PriznInfoItem( "Pokazateli","Показатель",0);
PriznInfo[1]=new PriznInfoItem( "munr","Вхождение муниципального образования",1);
PriznInfo[2]=new PriznInfoItem( "tippos","Тип поселения",2);
PriznInfo[3]=new PriznInfoItem( "oktmo","Муниципальное  образование  (муниципальный район,городской округ, муниципальный округ)",3);
PriznInfo[4]=new PriznInfoItem( "vozr","Возрастные группы",4);
PriznInfo[5]=new PriznInfoItem( "god","Годы",5);
PriznInfo[6]=new PriznInfoItem( "period","Периоды",6);
ZagPrizn=new Array();
ShapPrizn=new Array();
BokPrizn=new Array();
}

function TestAllPriznInclude(){
  with (document.forms[1]){
    boOk=
       ((_Pokazateli[0].checked)||(_Pokazateli[1].checked)||(_Pokazateli[2].checked))
          &&
       ((_munr[0].checked)||(_munr[1].checked)||(_munr[2].checked))
          &&
       ((_tippos[0].checked)||(_tippos[1].checked)||(_tippos[2].checked))
          &&
       ((_oktmo[0].checked)||(_oktmo[1].checked)||(_oktmo[2].checked))
          &&
       ((_vozr[0].checked)||(_vozr[1].checked)||(_vozr[2].checked))
          &&
       ((_god[0].checked)||(_god[1].checked)||(_god[2].checked))
          &&
       ((_period[0].checked)||(_period[1].checked)||(_period[2].checked))
          ;
  }
  if (!boOk) {alert('Не все атрибуты включены в описание макета таблицы.');}
  return( boOk );
}
function TestShapBok(){
  if ((document.forms[1].Shap.options.length==0)||
      (document.forms[1].Bok.options.length==0))
  {
    alert('Необходимо чтобы в шапке и в боковике было выбрано хотя бы по одному реквизиту.');
    return( false );
  }
  else
    return( true );
}
function GetPriznName( Prizn ){
  for (ii=0; ii<PriznInfo.length; ii++ ){
    if (PriznInfo[ii].Prizn==Prizn){ 
      return(PriznInfo[ii].PriznName);
      break;
    }
  }
}
function GetPriznByName( PriznNm ){
  for (ii=0; ii<PriznInfo.length; ii++ ){
    if (PriznInfo[ii].PriznName==PriznNm){ 
      return(PriznInfo[ii].Prizn);
      break;
    }
  }
}
function WritePriznTable( PriznList, TPart ){
  var s="<TABLE width=300>";
  for (i=0;i<PriznList.length;i++){
    var PriznName=PriznList[i];
    var Prizn=GetPriznByName( PriznName );
    if (PriznList.length<2){
      s+='<TR><TD width=200>'+PriznList[i]+'</TD><TD></TD></TR>';
    } else {
      s+='<TR><TD width=200>'+PriznList[i]+'</TD><TD> <SELECT NAME=a_'+Prizn+' SIZE=1 CLASS=Select>';
      for (j=0;j<PriznList.length;j++){
        if (j==i){
          s+='<OPTION SELECTED>'+(j+1);
        } else {
          s+='<OPTION>'+(j+1);
        }  
      }  
      s+='</SELECT></TD></TR>';
    }
  }
  s+='</TABLE>';
  document.all[ TPart ].innerHTML=s;
}  

function AddPriznInList( PriznName, PriznList, TPart ){
  PriznList.length=PriznList.length+1;
  PriznList[PriznList.length-1]=PriznName;
  for (ii=0;ii<PriznInfo.length;ii++){
    if (PriznInfo[ii].PriznName==PriznName){
      PriznInfo[ii].TPart=TPart;
    }
  }
  WritePriznTable( PriznList, TPart );
 }
function AddPrizn( Prizn, TblPartNo ){
PriznName=GetPriznName( Prizn );
switch( TblPartNo ){ 
case 0:
  AddPriznInList( PriznName, ZagPrizn, "Zag" );
  break;
case 1:
  AddPriznInList( PriznName, ShapPrizn, "Shap" );
  break;
case 2:
  AddPriznInList( PriznName, BokPrizn, "Bok" );
}
}
 
function DelPriznInList( PriznName, PriznList, TPart ){
  PriznArr=new Array();
  j=0;
  for (i=0;i<PriznList.length;i++){
    if (PriznList[i] != PriznName){
      PriznArr[j]=PriznList[i];
      j++;
    }
  }
  PriznList.length=PriznArr.length;
  for (i=0;i<PriznArr.length;i++){
    PriznList[i]=PriznArr[i];
  }
  WritePriznTable( PriznList, TPart );
}  
function DelPrizn(Prizn, TblPartNo){
PriznName=GetPriznName( Prizn );
switch( TblPartNo ){ 
case 0:
  DelPriznInList( PriznName, ZagPrizn, "Zag" );
  break;
case 1:
  DelPriznInList( PriznName, ShapPrizn, "Shap" );
  break;
case 2:
  DelPriznInList( PriznName, BokPrizn, "Bok" );
}
}
function PriznInLstBx( Prizn, TblPartNo ){
switch( TblPartNo ){ 
case 0:
  PriznList= ZagPrizn;
  break;
case 1:
  PriznList= ShapPrizn;
  break;
case 2:
  PriznList= BokPrizn;
}
boFind=false;
  for (i=0;i<PriznList.length;i++){
    if (PriznList[i] == PriznName){
      boFind=true;
    }
  }
return( boFind );
}
function UpdateChk( Prizn, TblPartNo ){
PriznName=GetPriznName( Prizn );
if (document.all["_"+Prizn][TblPartNo].checked){
  if (!PriznInLstBx( Prizn, TblPartNo )){
    AddPrizn( Prizn, TblPartNo );
  }
}
for (j=0;j<3;j++){
  if (j!=TblPartNo){
  if (PriznInLstBx( Prizn, j )){
    DelPrizn( Prizn, j );
  }
}
}
}
rdLayoutType="";
newWindow=null;
