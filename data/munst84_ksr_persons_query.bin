function FormStrDsc(PriznLst, Postfix) {
  var s="";
  if (PriznLst.length>1){
    for (i=0;i<PriznLst.length;i++){
      var eltNm='a_'+GetPriznByName(PriznLst[i]);
      var j=document.all[eltNm].selectedIndex;
      var N=document.all[eltNm].options[j].text;
      s+=GetPriznByName(PriznLst[i])+'_'+Postfix+':'+N+';';
    }
  }
  else
  {
    s+=GetPriznByName(PriznLst[0])+'_'+Postfix+':'+1+';';
  }
  return s;
}
function CopyGeomDsc() {
  var s1= FormStrDsc(ZagPrizn, 'z');
  s1+= FormStrDsc(ShapPrizn, 's');
  s1+= FormStrDsc(BokPrizn, 'b');
  document.forms[1].QryGm.value=s1;
}
function TestPriznSequence(PriznLst) {
  Error=false;
  for (i=0;i<PriznLst.length;i++){
    for (j=0;j<PriznLst.length;j++){
      if (i!=j){
      var eltNm='a_'+GetPriznByName(PriznLst[i]);
      var k=document.all[eltNm].selectedIndex;
      var N1=document.all[eltNm].options[k].text;
          eltNm='a_'+GetPriznByName(PriznLst[j]);
          k=document.all[eltNm].selectedIndex;
      var N2=document.all[eltNm].options[k].text;
      Error=(N1==N2);
      if (Error) { break }
    }}
  }
  return Error;
}
function TestSequence(){
  var boErr1=false;
  if (ZagPrizn.length>1){
    boErr1=(TestPriznSequence(ZagPrizn));
  }
  if (!boErr1){
  if (ShapPrizn.length>1){
    boErr1=(TestPriznSequence(ShapPrizn));
  }
  }
  if (!boErr1){
  if (BokPrizn.length>1){
    boErr1=(TestPriznSequence(BokPrizn));
  }
  }
  if (boErr1){
    alert('Ошибка в нумерации последовательности признаков.');
    return false }
  else {
    return true }
}
