function Clr( prizn ){
  for ( i=0; i<document.forms[0].elements[ prizn ].length; i++ ) {
    document.forms[0].elements[ prizn ].options[i].selected=false;
  }
}
function Slct( prizn ){
  for ( i=0; i<document.forms[0].elements[ prizn ].length; i++ ) {
    document.forms[0].elements[ prizn ].options[i].selected=true;
  }
ChangeLayout();
}
function ClrChk( eltName ){
  document.forms[0].elements[ eltName ].checked=false;
}
