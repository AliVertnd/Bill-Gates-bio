function CountPriznLocate(){
var iPD=0;
with (document.forms[1]) {
((_Pokazateli[0].checked)||(_Pokazateli[1].checked)||(_Pokazateli[2].checked))?iPD++:{};
((_munr[0].checked)||(_munr[1].checked)||(_munr[2].checked))?iPD++:{};
((_tippos[0].checked)||(_tippos[1].checked)||(_tippos[2].checked))?iPD++:{};
((_oktmo[0].checked)||(_oktmo[1].checked)||(_oktmo[2].checked))?iPD++:{};
((_mest[0].checked)||(_mest[1].checked)||(_mest[2].checked))?iPD++:{};
((_god[0].checked)||(_god[1].checked)||(_god[2].checked))?iPD++:{};
((_period[0].checked)||(_period[1].checked)||(_period[2].checked))?iPD++:{};
return(iPD);
}
}
