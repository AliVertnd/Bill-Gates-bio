ActImg=newImg("cbsd/GoTbl.gif");
ActImg=newImg("cbsd/GoTblA.gif");
ImgLoadOk=true;
}
}
function newImg(arg) {
if (document.images) {
Res = new Image();
Res.src = arg;
return Res;
}
}
function chImg() {
if (document.images && ImgLoadOk) {
document[chImg.arguments[0]].src=chImg.arguments[1];
}
}
function ClearAttrSelection(){
with (document.forms[0]) {
for (var i=0;i< elements.length;i++) {
elements[i].options[0].selected=true;
if (elements[i].options.length>1){
for (var j=0;j<elements[i].options.length;j++) {
elements[i].options[j].selected=false;
}
}
}
}
}
function ClearLayoutSelection(){
with (document.forms[1]) {
for (var i=0;i< elements.length;i++) {
  if (( elements[i].name.substring( 0,1 )=='_')&&(elements[i].type=="radio")) {
    elements[i].checked=false;
  }
}
}
}
function MnlLayout(){
document.all["form2"].style.visibility="visible";
MakeIndicAttrPool();
if (rdLayoutType!="Mnl")
   InvertReadOnlyLayout();
rdLayoutType="Mnl";
document.location.href="#Bottom";
document.all("Manual").classname="Thick";
document.all("Automatic").classname="Thin";
}
function StandartLayout(){
ClearLayoutSelection();
with (document.forms[1]) {
iSL=0;
oldNm="";
for (var i=1;i< elements.length;i++) {
  if (( elements[i].name.substring( 0,1 )=='_')&&(elements[i].type=="radio")) {
    if (oldName!=elements[i].name){j=0} else {j++}
    if ((elements[i].name=='_Pokazateli')&&(j=1)){elements[i].checked=true}
    if ((elements[i].name!='_Pokazateli')&&(j=2)){elements[i].checked=true}
    oldName=elements[i].name;
  }
}
}
CountResultSz();
}
function CheckQryComplete(){
boOk=CheckAttrSelection();
if (boOk) {
boOk=CheckTblLayout();
if (boOk){
boOk=TestSequence();
if (boOk){
InitCodesArray();
ExtractAttrCodes();CopyGeomDsc();
}
}
}
return(boOk);
}
function AttrInfo( name, range, index ){
this.name=name;
this.range=range;
this.sortindex=index;
this.layout="";
}
function CountSelected( SelectElement ){
jCS=0;
for (iCS=0;iCS<SelectElement.length;iCS++) {
if (SelectElement.options[iCS].selected==true) {
jCS++;
}
}
return(jCS)
}
function CopyAloneToZag(){
ZagAttrLen=0;
if (CountAloneVal()>AttrPool.length-2){
ZagAttrLen=AttrPool.length-2;
}
else{
ZagAttrLen=CountAloneVal();
}
jCAZ=0;
iLastCopied=-1;
for (ii=0;ii<AttrPool.length;ii++){
if ((AttrPool[ii].range==1)&&(ZagAttrLen>jCAZ)){
ZagAttr[jCAZ]=new AttrInfo( AttrPool[ii].name, AttrPool[ii].range,
AttrPool[ii].sortindex);
ZagAttr[jCAZ].layout="z";
AttrPool[ii].layout="z";
iLastCopied=ii;
jCAZ++;
if (jCAZ==AttrPool.length-2){
break;
}
}
}
if ((AttrPool[AttrPool.length-1].layout=="")&&
(AttrPool[AttrPool.length-1].range==1)&&
(ZagAttr.length>0)&&(iLastCopied>=0))
{
AttrPool[iLastCopied].layout="";

ZagAttr[ZagAttr.length-1].name=AttrPool[AttrPool.length-1].name;
ZagAttr[ZagAttr.length-1].range=AttrPool[AttrPool.length-1].range;
ZagAttr[ZagAttr.length-1].sortindex=AttrPool[AttrPool.length-1].sortindex;
AttrPool[AttrPool.length-1].layout="z";
}
}


function CountTblPartSz(sPart){
Sz=1;
rSz=0;
for (iCTA=0;iCTA<AttrPool.length;iCTA++){
if (AttrPool[iCTA].layout==sPart){
Sz*=AttrPool[iCTA].range;
rSz=1;
}
}
if (rSz==1){
rSz=Sz;
}
else{
rSz=0;
}
return(rSz);
}
function CountTblPartAttr(sPart){
iA=0;
for (iCTA=0;iCTA<AttrPool.length;iCTA++){
if (AttrPool[iCTA].layout==sPart){
iA++
}
}
return(iA);
}
function AttemptCopyKNPToShap(){

for (i=0;i<AttrPool.length;i++){
  if ((AttrPool[i].name=="knp")&&(AttrPool[i].range<=10)&&(AttrPool[i].layout=="")){
ShapAttr[ShapAttr.length]=new AttrInfo( AttrPool[i].name, AttrPool[i].range,
AttrPool[i].sortindex);
AttrPool[i].layout="s";
ShapAttr[ShapAttr.length-1].layout="s";
}
}
}
function AttemptAddToShap(){
i=0;
for (i=0;i<AttrPool.length;i++){
if ((AttrPool[i].layout=="")&&(AttrPool[i].range<10)){

if (CountTblPartSz("s")==0){
ShapAttr[ShapAttr.length]=new AttrInfo( AttrPool[i].name, AttrPool[i].range,
AttrPool[i].sortindex);
AttrPool[i].layout="s";
ShapAttr[ShapAttr.length-1].layout="s";

break;
}
else
{
if ((CountTblPartSz("s")*AttrPool[i].range) <=10 ){
ShapAttr[ShapAttr.length]=new AttrInfo( AttrPool[i].name, AttrPool[i].range,
AttrPool[i].sortindex);
AttrPool[i].layout="s";
ShapAttr[ShapAttr.length-1].layout="s";
break;
}
}
}
}
}
function CopyYearsToShap(){
  for (i=0;i<AttrPool.length;i++){
    if ( AttrPool[i].name == 'god'){
      ShapAttr[ShapAttr.length]= new AttrInfo( AttrPool[i].name, AttrPool[i].range, AttrPool[i].sortindex);
      AttrPool[i].layout='s';
      ShapAttr[ShapAttr.length-1].layout='s';
    }
  }
}
function FormShap(){
ShapAttr=new Array();
CopyYearsToShap();
AttemptCopyKNPToShap();
iCikle=0;
boShapFormed=new Boolean(false);
while (boShapFormed!=true){
if (CountTblPartSz("s")>=10){
break;
}
if (CountTblPartAttr("")==1){
break;
}
AttemptAddToShap();

iCikle++;
if (iCikle==AttrPool.length){ break }
}
}
function CountAloneVal(){
jCA=0;
for (iCA=0;iCA<AttrPool.length;iCA++) {
if (AttrPool[iCA].range==1) {
jCA++;
}
}
return(jCA);
}
function MakeIndicAttrPool(){
j=0;
with (document.forms[0]) {
for (var i=0;i<elements.length;i++) {
  if (( elements[i].type != "checkbox" )&&( elements[i].name != "footnotes" )) {
    j++;
  }
}
}
AttrPool=new Array( j );
j=0;
with (document.forms[0]) {
for (var i=0;i<elements.length;i++) {
  if (( elements[i].type != "checkbox" )&&( elements[i].name != "footnotes" )) {
    AttrPool[j]=new AttrInfo( elements[i].name, CountSelected(elements[i]),
j);
    j++;
  }
}
}
}
function GetAttrLayout(sAttrName){
if (document.all['_'+sAttrName][0].checked){ sLayout='z'}
if (document.all['_'+sAttrName][1].checked){ sLayout='s'}
if (document.all['_'+sAttrName][2].checked){ sLayout='b'}
return(sLayout);
}
function RefreshAttrPoolData(){
if (AttrPool.length==0) {
  MakeIndicAttrPool();
  j=0;
  with (document.forms[0]) {
    for (var i=0;i<elements.length;i++) {
      if (( elements[i].type != "checkbox" )&&( elements[i].name != "footnotes" )) {
        AttrPool[j].layout=GetAttrLayout(AttrPool[j].name);
        j++;
      }
    }
  }
}
else {
  j=0;
  with (document.forms[0]) {
    for (var i=0;i<elements.length;i++) {
      if (( elements[i].type != "checkbox" )&&( elements[i].name != "footnotes" )) {
        AttrPool[j].layout=GetAttrLayout(AttrPool[j].name);
        AttrPool[j].range=CountSelected(elements[i]);
        j++;
      }
    }
  }
}
}
function CountResultSz(){
RefreshAttrPoolData();
nTables=1;
nRows=1
nCols=1;
for (i=0;i<AttrPool.length;i++){
if (AttrPool[i].layout=="z"){
nTables=nTables*AttrPool[i].range;
}
else
if (AttrPool[i].layout=="s"){
nCols=nCols*AttrPool[i].range;
}
else
if (AttrPool[i].layout=="z"){
nTables=nTables*AttrPool[i].range;
}
else
if (AttrPool[i].layout=="b"){
nRows=nRows*AttrPool[i].range;
}
}
document.forms[1].NVal.value=nTables*nRows*nCols;
document.forms[1].NTbl.value=nTables;
document.forms[1].NCol.value=nCols;
document.forms[1].NRow.value=nRows;

}
function ShowZagLayout(){
for (iz=0;iz<ZagAttr.length;iz++){
  document.all['_'+ZagAttr[iz].name][0].checked=true;
  UpdateChk(ZagAttr[iz].name,0);
}
}
function ShowShapLayout(){
for (is=0;is<ShapAttr.length;is++){
  document.all['_'+ShapAttr[is].name][1].checked=true;
  UpdateChk(ShapAttr[is].name,1);
}
}
function ShowBokLayout(){
for (ib=0;ib<AttrPool.length;ib++){
  if (AttrPool[ib].layout==""){
    document.all['_'+AttrPool[ib].name][2].checked=true;
    UpdateChk(AttrPool[ib].name,2);
  }
}
}


function InvertReadOnlyLayout(){
}

function ShowOptimized(){
ClearLayoutSelection();
ShowZagLayout();
ShowShapLayout();
ShowBokLayout();
}
function TestShap(){
if ((CountTblPartAttr("s")==0)&&(CountTblPartAttr("z")>0 )){
ShapAttr[0]=new AttrInfo(ZagAttr[0].name,ZagAttr[0].range,
                     ZagAttr[0].sortindex);
ShapAttr[0].layout="s";
for (ii=0;ii<AttrPool.length;ii++){
  if (AttrPool[ii].name==ShapAttr[0].name) {
    AttrPool[ii].layout="s";
}}
ZagAttr.splice(0,1)
}}
function OptimizeLayout(){
if (rdLayoutType!="Au"){InvertReadOnlyLayout()}
rdLayoutType="Au";document.forms[1].rdLayoutType.value="Au"
if (CheckAttrSelectionNM()==true){
ZagAttr=new Array();
MakeIndicAttrPool();
if (CountAloneVal()>0){
CopyAloneToZag()
}
FormShap();
TestShap();
ShowOptimized();
CountResultSz();
}
else
{
return( false );
}
}
function InitLoad(){
document.all["form2"].style.visibility="hidden";
CreatePriznInfo();
ShowSelectedAmount();
OptimizeLayout();
InitCodesArray();
document.all("Manual").classname="Thin";
document.all("Automatic").classname="Thick";
}
function ChangeLayout(){
ShowSelectedAmount();
if (rdLayoutType=="Mnl"){
CountResultSz();
}
else{
if (CheckAttrSelectionNM()==true){
if (rdLayoutType=="Au"){
OptimizeLayout();
}
else{
StandartLayout();
}
}

}
}
function ClearQryProc() {
ClearAttrSelection();
ClearLayoutSelection();
InitLoad();
}
function GetRusChar( code ){
  switch( code ){
    case 65:
      rChar="ф";
      break;
    case 66:
      rChar="и";
      break;
    case 67:      // c
      rChar="с";
      break;
    case 68:      // d
      rChar="в";
      break;
    case 69:      // e
      rChar="у";
      break;
    case 70:      // f
      rChar="а";
      break;
    case 71:      // g
      rChar="п";
      break;
    case 72:      // h
      rChar="р";
      break;
    case 73:      // i
      rChar="ш";
      break;
    case 74:      //  j
      rChar="о";
      break;
    case 75:      //  k
      rChar="л";
      break;
    case 76:      //  l
      rChar="д";
      break;
    case 77:
      rChar="ь";  //  m
      break;
    case 78:
      rChar="т";  //  n
      break;
    case 79:
      rChar="щ";  //  o
      break;
    case 80:
      rChar="з";  //  p
      break;
    case 81:
      rChar="й";  //  q
      break;
    case 82:
      rChar="к";   // r
      break;
    case 83:
      rChar="ы";   // s
      break;
    case 84:
      rChar="е";   // t
      break;
    case 85:
      rChar="г";   // u
      break;
    case 86:
      rChar="м";   // v
      break;
    case 87:
      rChar="ц";   // w
      break;
    case 88:
      rChar="ч";   // x
      break;
    case 89:
      rChar="н";   // y
      break;
    case 90:
      rChar="я";   // z
      break;
    case 188:
      rChar="б";
      break;
    case 190:
      rChar="ю";
      break;
    case 186:
      rChar="ж";
      break;
    case 222:
      rChar="э";
      break;
    case 219:
      rChar="х";
      break;
    case 221:
      rChar="ъ";
      break;
    default:
      rChar="|";
  }
  return rChar;
}
function UpDateKeyInList( Element, Str ) {
  if (( Element.type=="select-one" )|| ( Element.type=="select-multiple" )) {
    if ((Element.options[Element.selectedIndex].text.substring( 0,1 )!= Str )&&
        (Element.options[Element.selectedIndex].text.substring( 0,1 )!= Str.toUpperCase()))
    {
      for ( i=0; i<Element.length; i++ ) {
        if ((Element.options[i].text.substring( 0,1 )== Str )||
            (Element.options[i].text.substring( 0,1 )== Str.toUpperCase()))
        {
          Element.selectedIndex=i;
          break;
        }
      }
    }
  }
}
function keyDownEvent(){
  Str=GetRusChar( window.event.keyCode );
  UpDateKeyInList( window.event.srcElement, Str );
}
