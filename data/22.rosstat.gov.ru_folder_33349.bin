\u0441\u043a\u0441\u0442\u0430\u0442","html":"\u003Cdiv\u003E\n        \u003Cdiv class=\u0022icon-text icon-text--align-top\u0022\u003E\n            \u003Cdiv class=\u0022icon-text__icon\u0022\u003E\n                \u003Csvg class=\u0022svg-icon color-text-blue\u0022 width=\u002216\u0022 height=\u002216\u0022\u003E\n                    \u003Cuse xlink:href=\u0022#icon-svg-person\u0022\u003E\u003C\/use\u003E\n                \u003C\/svg\u003E\n            \u003C\/div\u003E\n            \u003Cdiv class=\u0022icon-text__text\u0022\u003E\u0428\u0430\u0431\u043b\u0438\u0435\u043d\u043a\u043e \u0418\u0440\u0438\u043d\u0430 \u0412\u043b\u0430\u0434\u0438\u043c\u0438\u0440\u043e\u0432\u043d\u0430\u003C\/div\u003E\n        \u003C\/div\u003E\n    \u003C\/div\u003E\n\n    \u003Cdiv\u003E\n        \u003Ca class=\u0022icon-text icon-text--align-top color-text-blue\u0022\n           href=\u0022mailto:81@rosstat.gov.ru\u0022\u003E\n            \u003Cspan class=\u0022icon-text__icon\u0022\u003E\n                \u003Csvg class=\u0022svg-icon\u0022 width=\u002216\u0022 height=\u002216\u0022\u003E\n                    \u003Cuse xlink:href=\u0022#icon-svg-envelope-fill\u0022\u003E\u003C\/use\u003E\n                \u003C\/svg\u003E\n            \u003C\/span\u003E\n            \u003Cspan class=\u0022icon-text__text\u0022\u003E81@rosstat.gov.ru\u003C\/span\u003E\n        \u003C\/a\u003E\n    \u003C\/div\u003E\n\n\u003Cdiv class=\u0022map-tooltip__footer\u0022\u003E\n    \u003Ca class=\u0022map-tooltip__link btn btn-light-primary\u0022\n       href=\u0022\/\/81.rosstat.gov.ru\u0022\u003E\n        \u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u043d\u0430 \u0441\u0430\u0439\u0442    \u003C\/a\u003E\n\u003C\/div\u003E\n"}]}}</script>

