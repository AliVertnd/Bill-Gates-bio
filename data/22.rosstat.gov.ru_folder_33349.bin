<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.min.js" integrity="sha384-skAcpIdS7UcVUC05LJ9Dxay8AXcDYfBJqt1CJ85S/CFujBsIzCIv+l9liuYLaMQ/" crossorigin="anonymous"></script>
<script type="text/javascript" src="https://code.jquery.com/jquery-1.8.2.js"></script>

<style type="text/css">
.overlay{
  position: fixed;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  z-index: 2;
  cursor: pointer;
  }
.popup{
width: 100%;
margin: 0 auto;
display: none;
position: fixed;
z-index: 1001;
min-width: 53%;
width: 50%;
min-height: 150px;
}
@media screen and (max-width: 800px) {
  .popup {
    min-width: 90%;
    font-size: 14px;
  }
}
.popup-head{
    background-color:#1657b8; 
    color: #ffffff; 
    padding: 10px 8px; 
    border-radius: 2px; 
    font-size: 16px;
}
.popup-body{
margin: 10px auto;
background: #ffffff;
position: relative;
z-index: 1003;
padding: 45px 35px;
border-radius: 2px;
font-size: 16px;
text-align: justify;
}
@media screen and (max-width: 800px) {
  .popup-body {
    font-size: 14px;
  }
}
.fnt-red{
    font-style: oblique;
    font-weight: bold;
    color: red;
}
.fnt-bl{
    font-style: oblique;
    font-weight: bold;
    color: blue; 
}
.close-btn {
    background-color:#1657b8!important;
    color: #FFFFFF!important;
    padding: 10px 20px;
    border-radius: 2px;
font-size: 14px;
    font-weight: bold;
    text-decoration: none;
}
.close-btn:hover{
    background-color:#0745a3!important;
cursor: pointer;
}
.center {
   left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}
.popup-phone {
    text-decoration: none;
    font-weight: 500;
}
.rating-info__btn a, .rating-info__btn-number {
    font-size: 0.9rem;
    font-weight: 500;
    color: #6d7a8f;
}
.list-group {
padding-left: 0 !important;
}
.list-group-item {
cursor: pointer;
margin-bottom: .0rem !important;
}
#home-chart {
height: 314px !important;
}
</style>
<script type='text/javascript'>
$(function(){
var overlay = $('<div id="overlay"></div>');
overlay.show();
overlay.appendTo(document.body);
$('.popup').fadeIn(500);
$('.close-btn').click(function(){
$('.overlay').fadeOut(100);
overlay.appendTo(document.body).remove();
return false;
});
});
</script>

