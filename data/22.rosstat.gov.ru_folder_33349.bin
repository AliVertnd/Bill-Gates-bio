Csvg class=\u0022svg-icon\u0022 width=\u002216\u0022 height=\u002216\u0022\u003E\n                    \u003Cuse xlink:href=\u0022#icon-svg-envelope-fill\u0022\u003E\u003C\/use\u003E\n                \u003C\/svg\u003E\n            \u003C\/span\u003E\n            \u003Cspan class=\u0022icon-text__text\u0022\u003E30@rosstat.gov.ru\u003C\/span\u003E\n        \u003C\/a\u003E\n    \u003C\/div\u003E\n\n\u003Cdiv class=\u0022map-tooltip__footer\u0022\u003E\n    \u003Ca class=\u0022map-tooltip__link btn btn-light-primary\u0022\n       href=\u0022\/\/30.rosstat.gov.ru\u0022\u003E\n        \u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u043d\u0430 \u0441\u0430\u0439\u0442    \u003C\/a\u003E\n\u003C\/div\u003E\n"}]},"RU-VGG":{"title":"\u0412\u043e\u043b\u0433\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u0430\u044f \u043e\u0431\u043b\u0430\u0441\u0442\u044c","link":"#","slides":[{"subtitle":"\u0422\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043e\u0440\u0433\u0430\u043d \u0424\u0435\u0434\u0435\u0440\u0430\u043b\u044c\u043d\u043e\u0439 \u0441\u043b\u0443\u0436\u0431\u044b \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438  \u043f\u043e \u0412\u043e\u043b\u0433\u043e\u0433\u0440\u0430\u0434\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438","html":"\u003Cdiv\u003E\n        \u003Cdiv class=\u0022icon-text icon-text--align-top\u0022\u003E\n            \u003Cdiv class=\u0022icon-text__icon\u0022\u003E\n                \u003Csvg class=\u0022svg-icon color-text-blue\u0022 width=\u002216\u0022 height=\u002216\u0022\u003E\n                    \u003Cuse xlink:href=\u0022#icon-svg-person\u0022\u003E\u003C\/use\u003E\n                \u003C\/svg\u003E\n            \u003C\/div\u003E\n            \u003Cdiv class=\u0022icon-text__text\u0022\u003E\u0421\u0430\u0444\u043e\u043d\u043e\u0432\u0430 \u0410\u043d\u043d\u0430 \u041f\u0430\u0432\u04