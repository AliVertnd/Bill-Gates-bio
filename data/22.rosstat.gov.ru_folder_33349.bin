            firstDay: 0
        };
    </script>
    
    <div class="acceptCookieBanner acceptCookieBannerHidden" tabindex="-1" role="dialog" aria-labelledby="Соглашение использование файлов cookie">
    Мы используем файлы cookies для улучшения работы сайта. 
    Продолжая пользоваться сайтом, вы соглашаетесь с условиями использования файлов cookies. 
    Чтобы ознакомится с нашей политикой конфиденциальности, условиями использования персональных данных, целями и способами использования файлов cookies, нажмите <a href="https://rosstat.gov.ru/politika-konfidencialnosti" target="_blank">здесь</a>.
    <br><br>
    <button type="button" class="btn btn-primary acceptCookieBannerAccess">Я согласен</button>
</div>

<script type="text/javascript">
    let accept_cookie_key = 'accept_cookie';
    if (!localStorage.getItem(accept_cookie_key)) {
        $('.acceptCookieBanner').removeClass('acceptCookieBannerHidden');
    }
    
    $('.acceptCookieBannerAccess').on('click', function() {
        localStorage.setItem('accept_cookie', '1');
        $('.acceptCookieBanner').addClass('acceptCookieBannerHidden');
    });
</script>

<style>
    .acceptCookieBanner {
        background-color: #fff;
        background-clip: padding-box;
        border: 1px solid #999;
        border: 1px solid rgba(0,0,0,.2);
        box-shadow: 0 5px 15px rgba(0,0,0,.5);
        outline: 0;
        text-align: left;
        position: fixed;
        bottom: 0;
        width: 80%;
        z-index: 1000;
        padding: 15px;
        margin: 30px auto;
        left: 0;
        right: 0;
    }

    .acceptCookieBannerHidden {
        display: none;
    }
</style>

        <script src="https://22.rosstat.gov.ru/assets/scripts/favorites.js"></script>
    <script>
        $('.list__btn-add a').click(function (e) {
            e.preventDefault();

            var link = $(this);
            var page = link.data('page');
            if (! page) {
                page = 2;
            }

            $.ajax({
                method: 'get',
                url: link.data('href'),
                data: {page: page},
                success: function(data) {
                    var linkParent = link.parent();
                    var parentBlock = linkParent.parent();

                    parentBlock.children('.list__items').first().append(data.view);

                    if (! data.more) {
                        linkParent.hide();
                    }

                    page++;
                    link.data('page', page);
                }
            });
        });
    </script>
    <script>
        $(function () {
            function updateCaptchaAudio(elements = null) {
                let subjects = elements !== null ? $(elements)
                    : $('.captcha-audio').filter('[src]');

                subjects.attr('src', 'https://22.rosstat.gov.ru/audiocaptcha/audio?HvzDvcbW' + Math.random());
            }

            $('.captcha__link-refresh').on('click', function (event) {
                event.preventDefault();
                event.stopImmediatePropagation();

                $('.captcha-img').attr('src', 'https://22.rosstat.gov.ru/audiocaptcha/ru?L7Jw62An' + Math.random());
            });

            $('.captcha-img').first().on('load', function (event) {
                event.stopImmediatePropagation();

                if ($('.captcha-audio').is('[src]')) {
                    updateCaptchaAudio();
                }
            });

            $('.captcha__link-audio').on('click', function (event) {
                event.preventDefault();
                event.stopImmediatePropagation();

                let audio = this.querySelector('audio');

                if (!audio.hasAttribute('src')) {
                    updateCaptchaAudio(audio);
                }

                if (audio.paused) {
                    audio.play();
                }
                else {
                    audio.pause();
                    audio.currentTime = 0;
                }
            });
        });
    </script>
    <script>
        $('.misprint__form form').on('submit', function(e) {
            e.preventDefault();

            let form = $(this);

            $.ajax({
                method: form.attr('method'),
                url: form.attr('action'),
                data: form.serialize(),
                success: function () {
                    $.fancybox.close();
                },
                error: function (data) {
                    let errors = data.responseJSON.errors;

                    $.each(errors, function (key, value) {
                        let element = form.find('[name="'+key+'"]');
                        let parent = element.parents('.form-group');
                        element.addClass('is-invalid');
                        parent.find('.invalid-feedback').text(value);
                    });

                    $('.captcha__link-refresh').click();
                    $('[name="captcha"]').val('');
                },
            });
        })
    </script>
  </body>
</html>
